{"data":[{"airdate":"2026-10-05","name":"ロメリアという少女","name_cn":"","duration":"","desc":"魔王ゼルギス討伐に赴いたロメリア一行は、アンリ王子の独断的な突撃により激戦となるが、仲間の連携でなんとか魔王を討ち取った。しかしその戦いの後、戦闘に直接加わらなかったとしてロメリアはパーティ一行から足手まといだと断罪され、アンリから一方的に婚約を破棄されてしまう。凱旋に参加することも許されず、実家に帰ることとなったロメリアを迎えたのは、周囲の冷たい反応だった。商人にも見下され、母にも失望されたロメリアだったが、彼女はくじけなかった。彼女には彼女の、次へ目指す道が見えていたから。","ep":1,"sort":1,"id":1746303,"subject_id":511936,"comment":6,"type":0,"disc":0,"duration_seconds":0},{"airdate":"2026-10-12","name":"","name_cn":"","duration":"","desc":"","ep":2,"sort":2,"id":1746304,"subject_id":511936,"comment":0,"type":0,"disc":0,"duration_seconds":0},{"airdate":"2026-10-19","name":"","name_cn":"","duration":"","desc":"","ep":3,"sort":3,"id":1746305,"subject_id":511936,"comment":0,"type":0,"disc":0,"duration_seconds":0},{"airdate":"2026-10-26","name":"","name_cn":"","duration":"","desc":"","ep":4,"sort":4,"id":1746306,"subject_id":511936,"comment":0,"type":0,"disc":0,"duration_seconds":0},{"airdate":"2026-11-02","name":"","name_cn":"","duration":"","desc":"","ep":5,"sort":5,"id":1746307,"subject_id":511936,"comment":0,"type":0,"disc":0,"duration_seconds":0},{"airdate":"2026-11-09","name":"","name_cn":"","duration":"","desc":"","ep":6,"sort":6,"id":1746308,"subject_id":511936,"comment":0,"type":0,"disc":0,"duration_seconds":0},{"airdate":"2026-11-16","name":"","name_cn":"","duration":"","desc":"","ep":7,"sort":7,"id":1746309,"subject_id":511936,"comment":0,"type":0,"disc":0,"duration_seconds":0},{"airdate":"2026-11-23","name":"","name_cn":"","duration":"","desc":"","ep":8,"sort":8,"id":1746310,"subject_id":511936,"comment":0,"type":0,"disc":0,"duration_seconds":0},{"airdate":"2026-11-30","name":"","name_cn":"","duration":"","desc":"","ep":9,"sort":9,"id":1746311,"subject_id":511936,"comment":0,"type":0,"disc":0,"duration_seconds":0},{"airdate":"2026-12-07","name":"","name_cn":"","duration":"","desc":"","ep":10,"sort":10,"id":1746312,"subject_id":511936,"comment":0,"type":0,"disc":0,"duration_seconds":0},{"airdate":"2026-12